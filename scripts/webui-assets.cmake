# Embeds the files of a web UI build into one C++ source: a byte array per file and a table of them
# (see examples/server/webui-llamacpp-assets.h). The files are gzip-compressed when CMake can do it
# (3.18 and newer), and are then served with Content-Encoding: gzip.
#
# Usage: cmake -DDIST_DIR=<the build> -DOUTPUT=<file.cpp> -DWORK_DIR=<directory for the compressed copies>
#              -P scripts/webui-assets.cmake
#
# Adapted from scripts/ui-assets.cmake of llama.cpp.

set(DIST_DIR "" CACHE STRING "Directory of the web UI build (holds index.html)")
set(OUTPUT   "" CACHE STRING "C++ source to write")
set(WORK_DIR "" CACHE STRING "Directory for the compressed copies")

function(mime_from_ext name out_var)
    string(REGEX MATCH "\\.([^./]*)$" ext "${name}")
    set(ext "${CMAKE_MATCH_1}")
    if(ext STREQUAL "html")
        set(m "text/html; charset=utf-8")
    elseif(ext STREQUAL "css")
        set(m "text/css")
    elseif(ext STREQUAL "js" OR ext STREQUAL "mjs")
        set(m "application/javascript")
    elseif(ext STREQUAL "json")
        set(m "application/json")
    elseif(ext STREQUAL "webmanifest")
        set(m "application/manifest+json")
    elseif(ext STREQUAL "svg")
        set(m "image/svg+xml")
    elseif(ext STREQUAL "png")
        set(m "image/png")
    elseif(ext STREQUAL "jpg" OR ext STREQUAL "jpeg")
        set(m "image/jpeg")
    elseif(ext STREQUAL "ico")
        set(m "image/x-icon")
    elseif(ext STREQUAL "woff")
        set(m "font/woff")
    elseif(ext STREQUAL "woff2")
        set(m "font/woff2")
    elseif(ext STREQUAL "wasm")
        set(m "application/wasm")
    else()
        set(m "application/octet-stream")
    endif()
    set(${out_var} "${m}" PARENT_SCOPE)
endfunction()

if(NOT EXISTS "${DIST_DIR}/index.html")
    message(FATAL_ERROR "webui: no index.html in ${DIST_DIR}")
endif()

file(GLOB_RECURSE assets LIST_DIRECTORIES false RELATIVE "${DIST_DIR}" "${DIST_DIR}/*")
# loading.html is the page shown while the model loads: it is embedded on its own
list(FILTER assets EXCLUDE REGEX "(^loading\\.html$|\\.map$|^UPSTREAM$)")
list(SORT assets)

set(embed_dir "${DIST_DIR}")
set(use_gzip false)
if(NOT CMAKE_VERSION VERSION_LESS 3.18)
    # a zero timestamp in the gzip header: the same input gives the same bytes, and the same ETag, everywhere
    set(ENV{SOURCE_DATE_EPOCH} 0)
    set(embed_dir "${WORK_DIR}/gzip")
    file(REMOVE_RECURSE "${embed_dir}")
    foreach(f IN LISTS assets)
        get_filename_component(dst_dir "${embed_dir}/${f}" DIRECTORY)
        file(MAKE_DIRECTORY "${dst_dir}")
        file(ARCHIVE_CREATE OUTPUT "${embed_dir}/${f}" PATHS "${DIST_DIR}/${f}" FORMAT raw COMPRESSION GZip)
    endforeach()
    set(use_gzip true)
endif()

set(arrays "")
set(table "")
set(idx 0)
foreach(f IN LISTS assets)
    file(READ "${embed_dir}/${f}" hex HEX)
    if(hex STREQUAL "")
        message(FATAL_ERROR "webui: empty file: ${embed_dir}/${f}")
    endif()
    string(REGEX REPLACE "(..)" "0x\\1," bytes "${hex}")
    file(SHA256 "${embed_dir}/${f}" etag)
    mime_from_ext("${f}" mime)
    string(APPEND arrays "static const unsigned char asset_${idx}[] = {${bytes}};\n")
    string(APPEND table "    { \"${f}\", asset_${idx}, sizeof(asset_${idx}), \"\\\"${etag}\\\"\", \"${mime}\" },\n")
    math(EXPR idx "${idx} + 1")
endforeach()

file(WRITE "${OUTPUT}"
"// Generated by scripts/webui-assets.cmake from ${idx} files - do not edit.

#include \"webui-llamacpp-assets.h\"

${arrays}
const webui_asset webui_llamacpp_assets[] = {
${table}};
const size_t webui_llamacpp_n_assets = ${idx};
const bool   webui_llamacpp_gzip     = ${use_gzip};
")
message(STATUS "webui: embedded ${idx} files (gzip: ${use_gzip})")
